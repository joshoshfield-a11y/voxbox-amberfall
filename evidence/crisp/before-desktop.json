  "spec": "{\"meta\":{\"name\":\"Ancient Realm\",\"seed\":1963762346,\"genre\":\"third-person-action\",\"description\":\"a heroic knight adventure through ancient forest ruins at dusk\",\"version\":1},\"theme\":{\"palette\":{\"primary\":\"#9a9484\",\"secondary\":\"#6a6558\",\"accent\":\"#ffd76a\",\"sky\":\"#a8bcd8\",\"horizon\":\"#e0d9c4\",\"ground\":\"#7d7868\",\"groundAlt\":\"#8a8574\",\"rock\":\"#9a9484\",\"fog\":\"#d8d2c0\",\"water\":\"#4a8a9a\"},\"environment\":\"ruins\",\"timeOfDay\":\"dusk\",\"weather\":\"clear\",\"retroFilter\":true,\"bloom\":true},\"world\":{\"terrain\":{\"type\":\"hills\",\"size\":8000,\"maxHeight\":14,\"roughness\":0.5,\"water\":false,\"waterLevel\":-2},\"boundary\":\"walls\",\"gravity\":-22,\"scatter\":{\"density\":0.65,\"trees\":false,\"rocks\":true,\"crystals\":false,\"buildings\":0,\"ruins\":true},\"portals\":{\"enabled\":true}},\"player\":{\"type\":\"humanoid\",\"health\":100,\"speed\":7,\"jump\":9,\"abilities\":[\"dash\",\"sprint\"],\"weapon\":\"sword\",\"camera\":\"third-person\"},\"enemies\":[{\"kind\":\"walker\",\"count\":6,\"health\":30,\"speed\":4.5,\"damage\":9,\"weapon\":\"melee\"}],\"objective\":{\"type\":\"eliminate\",\"count\":6,\"timeLimit\":0,\"description\":\"Eliminate 6 hostiles\",\"stages\":[{\"id\":\"shards\",\"type\":\"collect\",\"count\":14,\"timeLimit\":0,\"description\":\"Chapter I — Gather the shards\"},{\"id\":\"break\",\"type\":\"eliminate\",\"count\":6,\"timeLimit\":0,\"description\":\"Chapter II — Clear the field — the last of them flee. Let them go, or hunt them down?\",\"choices\":[{\"label\":\"Take the high road\",\"next\":\"beacon\"},{\"label\":\"Hunt the stragglers\",\"next\":\"hunt\"}]},{\"id\":\"beacon\",\"type\":\"reach\",\"count\":0,\"timeLimit\":0,\"next\":[],\"description\":\"Chapter III — Reach the beacon\",\"winText\":\"You let them run. The beacon flares — Ancient Realm is crossed.\"},{\"id\":\"hunt\",\"type\":\"eliminate\",\"count\":1,\"timeLimit\":0,\"next\":[],\"description\":\"Chapter III — Hunt the stragglers\",\"winText\":\"No stragglers left. The beacon flares over a quiet field — Ancient Realm is crossed.\"}]},\"pickups\":{\"coins\":14,\"health\":4,\"ammo\":0,\"powerups\":2},\"rules\":{\"lives\":3,\"difficulty\":\"normal\"},\"audio\":{\"music\":true,\"mood\":\"heroic\",\"tempo\":112,\"key\":10,\"mode\":\"minor\",\"sfxVolume\":0.9,\"musicVolume\":0.7},\"narrative\":{\"premise\":\"Something iron-jawed stirs in the ancient ruins. Cross Ancient Realm: gather the shards, break the raiders, and reach the beacon on the far side.\",\"winText\":\"The beacon flares. Ancient Realm is crossed and the raiders are scattered.\",\"loseText\":\"The raiders reclaim the ancient ruins. The beacon goes dark.\"},\"progression\":{\"enabled\":true,\"xpPerKill\":20,\"xpPerPickup\":5},\"custom\":{\"portalMap\":{\"mx\":0,\"my\":0,\"worldSeed\":3712409144},\"items\":{\"defs\":{\"mat_ore\":{\"name\":\"Iron Ore\",\"type\":\"material\",\"rarity\":\"common\",\"stack\":999,\"value\":2,\"description\":\"Raw ore pried from a vein. Smelts into workable iron.\"},\"mat_fiber\":{\"name\":\"Plant Fiber\",\"type\":\"material\",\"rarity\":\"common\",\"stack\":999,\"value\":1,\"description\":\"Tough plant fiber. Binds, wraps, and weaves.\"},\"mat_scrap\":{\"name\":\"Salvage Scrap\",\"type\":\"material\",\"rarity\":\"common\",\"stack\":999,\"value\":3,\"description\":\"Bent plates and dead circuitry. Still useful.\"},\"mat_herb\":{\"name\":\"Wild Herbs\",\"type\":\"material\",\"rarity\":\"common\",\"stack\":999,\"value\":2,\"description\":\"Bitter leaves from a herb patch. Brewable.\"},\"mat_crystal\":{\"name\":\"Amber Crystal\",\"type\":\"material\",\"rarity\":\"uncommon\",\"stack\":999,\"value\":8,\"description\":\"A shard pried from a crystal cluster. Hums faintly.\"},\"craft_ember_blade\":{\"name\":\"Ember Blade\",\"type\":\"weapon\",\"slot\":\"weapon\",\"stats\":{\"damage\":14,\"crit\":3},\"rarity\":\"rare\",\"stack\":1,\"value\":320,\"description\":\"An Iron Edge re-forged around living ember. The forge remembers.\"},\"craft_scorched_harness\":{\"name\":\"Scorched Harness\",\"type\":\"armor\",\"slot\":\"torso\",\"stats\":{\"defense\":7,\"maxHealth\":5},\"rarity\":\"rare\",\"stack\":1,\"value\":260,\"description\":\"A buckler grown into a full harness, hide-stitched and heat-cured.\"},\"craft_surge_elixir\":{\"name\":\"Surge Elixir\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"heal\",\"amount\":80},\"rarity\":\"epic\",\"stack\":5,\"value\":90,\"description\":\"An Ember Tonic cut with core-light. Restores 80 health.\"},\"craft_starfall_warbrand\":{\"name\":\"Starfall Warbrand\",\"type\":\"weapon\",\"slot\":\"weapon\",\"stats\":{\"damage\":18,\"crit\":6},\"rarity\":\"epic\",\"stack\":1,\"value\":700,\"description\":\"An Ember Blade re-forged around a machine core. The edge hums in the dark.\"},\"craft_dragonscale_aegis\":{\"name\":\"Dragonscale Aegis\",\"type\":\"armor\",\"slot\":\"legs\",\"stats\":{\"defense\":11,\"maxHealth\":10},\"rarity\":\"epic\",\"stack\":1,\"value\":620,\"description\":\"Hide-stitched leg plates cured around core-light. Master smith work.\"},\"craft_primordial_draught\":{\"name\":\"Primordial Draught\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"heal\",\"amount\":150},\"rarity\":\"epic\",\"stack\":5,\"value\":220,\"description\":\"A Surge Elixir folded over living ember. Restores 150 health.\"},\"craft_wildheart_regalia\":{\"name\":\"Wildheart Regalia\",\"type\":\"armor\",\"slot\":\"accessory\",\"stats\":{\"defense\":6,\"maxHealth\":20},\"rarity\":\"epic\",\"stack\":1,\"value\":480,\"description\":\"Beast-hide regalia bound with trail-craft. The wilds approve.\"},\"set_masterforged_crown\":{\"name\":\"Masterforged Crown\",\"type\":\"armor\",\"slot\":\"head\",\"stats\":{\"defense\":8,\"maxHealth\":20},\"rarity\":\"epic\",\"stack\":1,\"value\":680,\"description\":\"Masterforged piece (1/4). Only a rank-3 smith may forge it.\"},\"deploy_campfire\":{\"name\":\"Campfire Kit\",\"type\":\"consumable\",\"rarity\":\"uncommon\",\"stack\":5,\"value\":15,\"description\":\"A bundled campfire. Deploy with G — heals you in its light.\"},\"deploy_spike_trap\":{\"name\":\"Spike Trap Kit\",\"type\":\"consumable\",\"rarity\":\"uncommon\",\"stack\":5,\"value\":20,\"description\":\"A folded spike plate. Deploy with G — shreds enemies that step in.\"},\"deploy_lure_totem\":{\"name\":\"Lure Totem Kit\",\"type\":\"consumable\",\"rarity\":\"uncommon\",\"stack\":5,\"value\":25,\"description\":\"A carved decoy totem. Deploy with G — enemies hunt it, not you.\"},\"craft_field_kit\":{\"name\":\"Field Repair Kit\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"heal\",\"amount\":35},\"rarity\":\"common\",\"stack\":5,\"value\":12,\"description\":\"Patches you up in the field. Restores 35 health.\"},\"craft_iron_edge\":{\"name\":\"Iron Edge\",\"type\":\"weapon\",\"slot\":\"weapon\",\"stats\":{\"damage\":6},\"rarity\":\"uncommon\",\"value\":45,\"description\":\"A crude but honest blade, hammered at the anvil.\"},\"craft_fiber_weave\":{\"name\":\"Fiber Weave Vest\",\"type\":\"armor\",\"slot\":\"torso\",\"stats\":{\"defense\":4},\"rarity\":\"common\",\"value\":20,\"description\":\"Layered fiber padding. Light, quiet, better than nothing.\"},\"craft_scrap_buckler\":{\"name\":\"Scrap Buckler\",\"type\":\"armor\",\"slot\":\"accessory\",\"stats\":{\"defense\":2},\"rarity\":\"common\",\"value\":18,\"description\":\"A dinner-plate shield, more or less.\"},\"craft_ember_tonic\":{\"name\":\"Ember Tonic\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"buff\",\"amount\":20,\"duration\":60},\"rarity\":\"uncommon\",\"stack\":5,\"value\":30,\"description\":\"Burns going down. +20% damage for 60 seconds.\"},\"craft_spark_charge\":{\"name\":\"Spark Charge\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"buff\",\"amount\":15,\"duration\":30},\"rarity\":\"uncommon\",\"stack\":5,\"value\":28,\"description\":\"Overclocks your reflexes. +15% crit for 30 seconds.\"},\"craft_grip_wrap\":{\"name\":\"Grip Wrap\",\"type\":\"trinket\",\"stats\":{\"attackSpeed\":5},\"rarity\":\"uncommon\",\"value\":32,\"description\":\"Fiber-and-scrap wrap. Swings come a little faster.\"},\"craft_alloy_greaves\":{\"name\":\"Alloy Greaves\",\"type\":\"armor\",\"slot\":\"legs\",\"stats\":{\"defense\":5},\"rarity\":\"uncommon\",\"value\":40,\"description\":\"Forge-poured leg plates. Heavy, but they hold.\"},\"craft_trail_mix\":{\"name\":\"Trail Mix\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"heal\",\"amount\":15},\"rarity\":\"common\",\"stack\":10,\"value\":6,\"description\":\"Dried fiber-fruit and grit. Restores 15 health.\"},\"craft_whetstone\":{\"name\":\"Whetstone\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"buff\",\"amount\":10,\"duration\":45},\"rarity\":\"common\",\"stack\":5,\"value\":10,\"description\":\"Puts a keener edge on your next swings. +10% attack speed for 45 seconds.\"},\"craft_herb_poultice\":{\"name\":\"Herb Poultice\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"heal\",\"amount\":25},\"rarity\":\"common\",\"stack\":10,\"value\":8,\"description\":\"Pounded herbs in a fiber wrap. Restores 25 health.\"},\"craft_crystal_lens\":{\"name\":\"Crystal Lens\",\"type\":\"trinket\",\"stats\":{\"damage\":2},\"rarity\":\"uncommon\",\"value\":60,\"description\":\"A focused amber lens. Your strikes bite a little deeper.\"},\"mat_ember_shard\":{\"name\":\"Ember Shard\",\"type\":\"material\",\"rarity\":\"uncommon\",\"stack\":999,\"value\":8,\"description\":\"A still-warm shard of ember-forged plating. Burns nothing; forges everything.\"},\"mat_beast_hide\":{\"name\":\"Beast Hide\",\"type\":\"material\",\"rarity\":\"common\",\"stack\":999,\"value\":4,\"description\":\"Thick hide torn from a husk-beast. Takes stitching well.\"},\"mat_core_fragment\":{\"name\":\"Core Fragment\",\"type\":\"material\",\"rarity\":\"uncommon\",\"stack\":999,\"value\":10,\"description\":\"A humming fragment of a machine core. Still faintly warm.\"},\"loot_ironfang_blade\":{\"name\":\"Ironfang Blade\",\"type\":\"weapon\",\"slot\":\"weapon\",\"stats\":{\"damage\":9},\"rarity\":\"uncommon\",\"stack\":1,\"value\":120,\"description\":\"A scavenged blade with a hungry edge. Better than issue steel.\"},\"loot_scorched_plate\":{\"name\":\"Scorched Plate\",\"type\":\"armor\",\"slot\":\"torso\",\"stats\":{\"defense\":8},\"rarity\":\"rare\",\"stack\":1,\"value\":200,\"description\":\"Battle-scorched plate, still sound. Smells of ozone.\"},\"loot_void_edge\":{\"name\":\"Void Edge\",\"type\":\"weapon\",\"slot\":\"weapon\",\"stats\":{\"damage\":16,\"crit\":5},\"rarity\":\"epic\",\"stack\":1,\"value\":450,\"description\":\"An edge that drinks the light around it. Handle with respect.\"},\"loot_war_helm\":{\"name\":\"War Helm\",\"type\":\"armor\",\"slot\":\"head\",\"stats\":{\"defense\":5,\"maxHealth\":10},\"rarity\":\"rare\",\"stack\":1,\"value\":180,\"description\":\"A dented war helm. The last owner does not miss it.\"},\"loot_star_aegis\":{\"name\":\"Starforged Aegis\",\"type\":\"armor\",\"slot\":\"accessory\",\"stats\":{\"defense\":10,\"maxHealth\":25},\"rarity\":\"legendary\",\"stack\":1,\"value\":900,\"description\":\"An aegis hammered from fallen star-metal. Bosses only.\"},\"loot_surge_tonic\":{\"name\":\"Surge Tonic\",\"type\":\"consumable\",\"behavior\":{\"effect\":\"heal\",\"amount\":50},\"rarity\":\"uncommon\",\"stack\":5,\"value\":30,\"description\":\"Fizzes like a storm. Restores 50 health.\"},\"set_ironfang_helm\":{\"name\":\"Ironfang Helm\",\"type\":\"armor\",\"slot\":\"head\",\"stats\":{\"defense\":3},\"rarity\":\"uncommon\",\"stack\":1,\"value\":90,\"description\":\"Ironfang Raider piece (1/4). A dented helm, still loyal.\"},\"set_ironfang_greaves\":{\"name\":\"Ironfang Greaves\",\"type\":\"armor\",\"slot\":\"legs\",\"stats\":{\"defense\":3},\"rarity\":\"uncommon\",\"stack\":1,\"value\":90,\"description\":\"Ironfang Raider piece (2/4). Greaves that have outrun their owners.\"},\"set_emberforged_cowl\":{\"name\":\"Emberforged Cowl\",\"type\":\"armor\",\"slot\":\"head\",\"stats\":{\"defense\":5,\"maxHealth\":8},\"rarity\":\"rare\",\"stack\":1,\"value\":240,\"description\":\"Emberforged piece (1/4). Heat-cured plate, amber-veined.\"},\"set_emberforged_sabatons\":{\"name\":\"Emberforged Sabatons\",\"type\":\"armor\",\"slot\":\"legs\",\"stats\":{\"defense\":5},\"rarity\":\"rare\",\"stack\":1,\"value\":210,\"description\":\"Emberforged piece (2/4). Sabatons that leave warm footprints.\"},\"set_voidborn_cuirass\":{\"name\":\"Voidborn Cuirass\",\"type\":\"armor\",\"slot\":\"torso\",\"stats\":{\"defense\":9,\"maxHealth\":15},\"rarity\":\"epic\",\"stack\":1,\"value\":520,\"description\":\"Voidborn piece (1/4). Starlight never reaches the bottom of it.\"},\"set_voidborn_pauldrons\":{\"name\":\"Voidborn Pauldrons\",\"type\":\"armor\",\"slot\":\"legs\",\"stats\":{\"defense\":8,\"crit\":4},\"rarity\":\"epic\",\"stack\":1,\"value\":500,\"description\":\"Voidborn piece (2/4). Shouldered night.\"},\"mat_enchant_dust\":{\"name\":\"Enchant Dust\",\"type\":\"material\",\"rarity\":\"uncommon\",\"stack\":999,\"value\":12,\"description\":\"Fine dust that holds a charge. The base note of every enchantment.\"},\"mat_star_essence\":{\"name\":\"Star Essence\",\"type\":\"material\",\"rarity\":\"rare\",\"stack\":999,\"value\":30,\"description\":\"Condensed starlight, cold to the touch. For the sharper enchants.\"}}}}}"
